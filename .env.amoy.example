# Copy to .env.amoy or export these values in the shell. Never commit real values.
# Use a dedicated endpoint, for example: https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Shared demo/public RPCs may be unavailable or rate-limited.
AMOY_RPC_URL=
AMOY_DEPLOYER_PRIVATE_KEY=
AMOY_RISK_RESERVE_ADDRESS=
AMOY_MAINTENANCE_TREASURY_ADDRESS=
POLYGONSCAN_API_KEY=

# Optional: only needed for the automated CLI two-wallet flow. Leave blank
# when Wallet A and Wallet B will connect and sign interactively in MetaMask.
AMOY_WALLET_A_PRIVATE_KEY=
AMOY_WALLET_B_PRIVATE_KEY=

# Vite public configuration. Amoy mode reads its factory address from the deployment manifest.
VITE_EVM_CHAIN_ID=0x13882
VITE_NETWORK_NAME=Polygon Amoy
VITE_BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
# Browser-visible, read-only endpoint for public listings and recent trades.
# Never put a private/privileged RPC credential in a VITE_ variable.
VITE_PUBLIC_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/demo
VITE_ENABLE_HARDHAT_FALLBACK=false
VITE_ENABLE_MOCK_TOKEN_FAUCET=true
