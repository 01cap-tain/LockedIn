# Copy to .env.amoy or export these values in the shell. Never commit real values.
AMOY_RPC_URL=
AMOY_DEPLOYER_PRIVATE_KEY=
AMOY_WALLET_A_PRIVATE_KEY=
AMOY_WALLET_B_PRIVATE_KEY=
AMOY_RISK_RESERVE_ADDRESS=
AMOY_MAINTENANCE_TREASURY_ADDRESS=
POLYGONSCAN_API_KEY=

# Vite public configuration. Amoy mode reads its factory address from the deployment manifest.
VITE_EVM_CHAIN_ID=0x13882
VITE_NETWORK_NAME=Polygon Amoy
VITE_BLOCK_EXPLORER_URL=https://amoy.polygonscan.com
VITE_ENABLE_HARDHAT_FALLBACK=false
