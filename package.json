{
  "name": "lockedin-circle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "contracts:node": "npm run node -w @lockedin-circle/contracts",
    "contracts:deploy": "npm run deploy:local -w @lockedin-circle/contracts",
    "contracts:smoke": "npm run smoke:local -w @lockedin-circle/contracts",
    "contracts:deploy:amoy": "npm run deploy:amoy -w @lockedin-circle/contracts",
    "contracts:verify:amoy": "npm run verify:amoy -w @lockedin-circle/contracts",
    "contracts:inspect:amoy": "npm run inspect:amoy -w @lockedin-circle/contracts",
    "contracts:prepare:polygon": "npm run prepare:polygon -w @lockedin-circle/contracts",
    "contracts:test:amoy": "npm run test:amoy -w @lockedin-circle/contracts",
    "contracts:test:amoy:persistence": "npm run test:amoy:persistence -w @lockedin-circle/contracts",
    "contracts:test:amoy:group": "npm run test:amoy:group -w @lockedin-circle/contracts",
    "contracts:inspect:amoy:group": "npm run inspect:amoy:group -w @lockedin-circle/contracts",
    "dev": "npm run dev -w @lockedin-circle/web",
    "dev:amoy": "npm run dev:amoy -w @lockedin-circle/web",
    "api:dev": "npm run dev -w @lockedin-circle/api",
    "api:migrate": "npm run migrate -w @lockedin-circle/api",
    "api:index": "npm run index -w @lockedin-circle/api",
    "api:backfill": "npm run backfill -w @lockedin-circle/api",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
