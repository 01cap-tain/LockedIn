# Public local-development values only. Never place private keys or secrets here.
VITE_HARDHAT_RPC_URL=http://127.0.0.1:8545
VITE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_EVM_CHAIN_ID=0x7a69
# Explicit local-only fallback. Keep false in production.
VITE_ENABLE_HARDHAT_FALLBACK=false
# Explicit simulation only; the adapter refuses mainnet/production settings.
VITE_ENABLE_MOCK_SWAPS=true
VITE_SWAP_ENVIRONMENT=local
VITE_SWAP_NIMIQ_NETWORK=testnet

# Read-only indexer/API. Use a dedicated local database role and never commit its password.
DATABASE_URL=postgresql://lockedin:CHANGE_ME@127.0.0.1:5432/lockedin_circle
INDEXER_RPC_URL=http://127.0.0.1:8545
INDEXER_MANIFEST_PATH=packages/contracts/deployments/local/latest.json
# Optional comma-separated immutable deployments, oldest first and active last.
# INDEXER_MANIFEST_PATHS=packages/contracts/deployments/amoy/legacy.json,packages/contracts/deployments/amoy/latest.json
INDEXER_CONFIRMATION_DEPTH=2
INDEXER_LOG_RANGE=100
INDEXER_POLL_INTERVAL_MS=5000
AUTH_SESSION_MINUTES=30
AUTH_NONCE_MINUTES=5
API_HOST=127.0.0.1
API_PORT=3001
