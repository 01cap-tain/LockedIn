{
  "name": "@lockedin-circle/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:polygon-fork": "hardhat test test/polygon-fork.js --network polygonFork --no-compile",
    "test:amoy": "hardhat run scripts/test-amoy-flow.js --network amoy --no-compile",
    "test:amoy:persistence": "hardhat run scripts/check-amoy-persistence.js --network amoy --no-compile",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.js --network localhost --no-compile",
    "smoke:local": "hardhat run scripts/smoke-local.js --network localhost --no-compile",
    "deploy:amoy": "hardhat run scripts/deploy-amoy.js --network amoy --no-compile",
    "verify:amoy": "hardhat run scripts/verify-amoy.js --network amoy --no-compile"
  },
  "dependencies": {
    "@aave-dao/aave-address-book": "^4.74.1",
    "@aave/core-v3": "^1.19.3",
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@nomicfoundation/hardhat-verify": "3.1.3",
    "hardhat": "3.20.0"
  }
}
