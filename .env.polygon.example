# LockedIn Circle Polygon production template. Copy to an ignored local file.
# VITE_* values are public and become part of the browser bundle. Never put a
# private key, mnemonic, database password, or privileged RPC credential here.

# Public frontend/indexer connectivity
VITE_PUBLIC_RPC_URL=
VITE_INDEXER_API_URL=
INDEXER_RPC_URL=
DATABASE_URL=

# Read-only production preflight inputs. Use reviewed multisig addresses.
POLYGON_RPC_URL=
POLYGON_DEPLOYER_ADDRESS=
# Do not add POLYGON_DEPLOYER_PRIVATE_KEY here. Store it with:
# npx hardhat keystore set POLYGON_DEPLOYER_PRIVATE_KEY
POLYGON_SAFETY_COUNCIL_ADDRESS=
POLYGON_RISK_RESERVE_ADDRESS=
POLYGON_MAINTENANCE_TREASURY_ADDRESS=
POLYGONSCAN_API_KEY=
POLYGON_MAX_DEPLOYMENT_COST_WEI=
POLYGON_APPROVED_DEPLOYER_NONCE=
POLYGON_DEPLOYMENT_APPROVED=

# Six-decimal USDT units. Launch ceilings must be independently reviewed.
POLYGON_MAX_POSITION_PRINCIPAL=
POLYGON_MAX_VAULT_PRINCIPAL=
POLYGON_MAX_PROTOCOL_PRINCIPAL=

# Seven hours. The factory independently rejects a lower value on chain 137.
POLYGON_MIN_MATURITY_SECONDS=25200
