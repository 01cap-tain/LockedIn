{
  "name": "@lockedin-circle/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:amoy": "tsc -b && vite build --mode amoy",
    "dev": "vite",
    "dev:amoy": "vite --mode amoy",
    "test": "vitest run src --pool=threads --maxWorkers=1",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@nimiq/mini-app-sdk": "0.2.4",
    "ethers": "6.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
