{
  "name": "@lockedin-circle/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && node scripts/build-production.js",
    "build:amoy": "tsc -b && vite build --mode amoy",
    "dev": "vite",
    "dev:amoy": "vite --mode amoy",
    "test": "vitest run src --pool=threads --maxWorkers=1",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@ncdai/react-wheel-picker": "^1.2.3",
    "@nimiq/mini-app-sdk": "0.2.4",
    "@radix-ui/react-slider": "^1.6.1",
    "ethers": "6.17.0",
    "lucide-react": "^1.60.0",
    "react": "19.3.0",
    "react-calendar": "^6.0.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^31.0.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
